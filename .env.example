# Copy to .env (git-ignored) and fill in. NEVER commit real values.

# --- Frontend ---------------------------------------------------------------
# Mapbox PUBLIC token (starts with pk.). Restrict it to your URLs in the Mapbox
# dashboard. NEVER put a secret sk. token here — it ends up in the JS bundle.
MAPBOX_TOKEN=pk.REPLACE_ME

# --- Backend ----------------------------------------------------------------
# Leave HOST unset to bind 127.0.0.1 (default, recommended).
# Setting it exposes the API on the network and logs a loud warning.
# HOST=0.0.0.0

# Dispatch webhook signing secret (HMAC-SHA256). Rotate per SECURITY.md.
DISPATCH_HMAC_SECRET=REPLACE_ME_WITH_32_RANDOM_BYTES_HEX

# Optional vision-LLM escalation (disabled by default, costs money).
ANTHROPIC_API_KEY=

# Optional camera credentials referenced from config.yaml (*_env keys).
ABQ_CAM_USER=
ABQ_CAM_PASS=
TOWER1_RTSP_URL=
SITE1_HLS_URL=
VERKADA_ORG_ID=
VERKADA_API_KEY=
